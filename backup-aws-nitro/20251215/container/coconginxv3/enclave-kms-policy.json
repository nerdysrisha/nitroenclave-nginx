{
  "Version": "2012-10-17",
  "Id": "key-configured-for-enclave",
  "Statement": [
    {
      "Sid": "Enable IAM User Permissions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::908774804544:root"
      },
