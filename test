5. New File: health-check.sh

#!/bin/bash
# Health check script for VSOCK connectivity

ENCLAVE_CID=$1
HEALTH_PORT=5001  # Health check port inside enclave

echo "Starting health check for enclave CID: $ENCLAVE_CID"

while true; do
    # Try to connect to enclave health port via VSOCK
    if echo "health" | socat -t 1 - VSOCK-CONNECT:$ENCLAVE_CID:$HEALTH_PORT 2>/dev/null; then
        echo "$(date): Enclave health check PASSED"
    else
        echo "$(date): Enclave health check FAILED"
    fi
    sleep 30
done

