4. New File: vsock-proxy.sh

#!/bin/bash
# VSOCK Proxy Script - Bridges TCP to VSOCK communication

ENCLAVE_CID=$1
TCP_PORT=${2:-80}
VSOCK_PORT=${3:-5000}

echo "Starting VSOCK proxy: TCP:$TCP_PORT -> VSOCK:$ENCLAVE_CID:$VSOCK_PORT"

# Start socat to bridge TCP to VSOCK
exec socat TCP-LISTEN:$TCP_PORT,fork,reuseaddr VSOCK-CONNECT:$ENCLAVE_CID:$VSOCK_PORT


