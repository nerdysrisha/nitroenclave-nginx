1. GitHub Application Dockerfile (nginx inside enclave)

FROM public.ecr.aws/amazonlinux/amazonlinux:2023

# Install nginx and socat for vsock communication
RUN dnf update -y && dnf install -y nginx socat

# Create a simple nginx configuration that listens on vsock port 5000
RUN echo "Hello from NGINX in Enclave via VSOCK!" > /usr/share/nginx/html/index.html && \
    # Configure nginx to listen on vsock port 5000 instead of TCP
    echo 'server { listen 5000 vsock; location / { root /usr/share/nginx/html; }}' > /etc/nginx/conf.d/vsock.conf && \
    # Disable default TCP listener
    echo '' > /etc/nginx/conf.d/default.conf

# Create startup script that starts nginx and vsock health check
RUN echo '#!/bin/bash\nnginx -g "daemon off;" &\n# Simple health check endpoint\nwhile true; do echo "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nOK" | nc -l -p 5001 -s 0.0.0.0; done &\nwait' > /start.sh && \
    chmod +x /start.sh

# Run the startup script
CMD ["/start.sh"]


